# ==============================================================================
# UAV Digital Twin — Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit .env or any secret keys to version control!
# ==============================================================================

# Agent 37 Hermes Cloud Neural Engine Configuration
AGENT37_API_KEY=your_agent37_api_key_here
AGENT37_INSTANCE_ID=c1iy0ok07a

# Backend & Network Configuration
UAV_TWIN_WS_HOST=127.0.0.1
UAV_TWIN_WS_PORT=8765
UAV_TWIN_API_PORT=8766

# Security & Multi-Tenancy (Optional)
UAV_TWIN_REQUIRE_AUTH=0
UAV_TWIN_JWT_SECRET=your_jwt_secret_here
UAV_TWIN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
